{
  "name": "steelesummts",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "prepare": "husky",
    "seed": "node --experimental-strip-types --env-file=.env.local scripts/seed-content.ts"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,css}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@portabletext/react": "^7.0.1",
    "@sanity/client": "^8.4.0",
    "@sanity/image-url": "^2.1.1",
    "@sanity/orderable-document-list": "^2.0.23",
    "@sanity/vision": "^6.11.0",
    "@sanity/webhook": "^4.0.4",
    "@tanstack/react-query": "^5.101.4",
    "next": "16.2.12",
    "next-sanity": "^13.3.3",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "sanity": "^6.11.0",
    "styled-components": "^6.4.4"
  },
  "devDependencies": {
    "@tanstack/react-query-devtools": "^5.101.4",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/styled-components": "^5.1.36",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.9.6",
    "typescript": "^5"
  }
}
