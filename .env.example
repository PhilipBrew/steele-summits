NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Set to the literal string "true" only when ready to be publicly indexed/crawled.
# Any other value (including unset) blocks robots.txt and adds a site-wide noindex
# meta tag — the safe default while content/legal pages aren't finished yet.
NEXT_PUBLIC_SITE_INDEXABLE=false

# Editor-scoped token, used only by the one-off content seed script — never used at runtime.
SANITY_SEED_TOKEN=

# Shared secret for the /api/revalidate webhook — set the same value in Sanity's webhook config.
SANITY_REVALIDATE_SECRET=

# Resend API key for the contact form's outbound notification email.
RESEND_API_KEY=

# Where contact form submissions are sent. Deliberately a separate value from
# any Sanity-managed contactEmail field, so changing displayed contact info
# in Studio can't silently redirect real enquiries.
CONTACT_NOTIFY_EMAIL=
