NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Editor-scoped token, used only by the one-off content seed script — never used at runtime.
SANITY_SEED_TOKEN=

# Shared secret for the /api/revalidate webhook — set the same value in Sanity's webhook config.
SANITY_REVALIDATE_SECRET=
